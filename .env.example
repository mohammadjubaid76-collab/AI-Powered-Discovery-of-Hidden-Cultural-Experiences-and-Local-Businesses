# Team Venator Environment Configuration
PORT=3000
NODE_ENV=development

# Google Gemini API Key (Gemini 1.5 Flash for NLP intent extraction)
GEMINI_API_KEY=your_gemini_api_key_here

# Distance Matrix API Key (Optional: fallbacks gracefully to deterministic haversine + road traffic multiplier)
DISTANCE_MATRIX_API_KEY=your_distance_matrix_key_here

# MongoDB Atlas Connection URI (Optional: fallbacks to local data/gwalior_curated_pois.json)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/tourism_gwalior?retryWrites=true&w=majority

# Circuit breaker timeout for external transit APIs (in milliseconds)
TRANSIT_API_TIMEOUT_MS=3000

# Safety buffer multiplier (0.25 = 25% mandatory buffer)
SAFETY_BUFFER_RATIO=0.25
